{
	"folders": [
		{
			"path": "../durion-positivity-frontend",
			"name": "Frontend"
		},
		{
			"path": ".",
			"name": "Durion"
		},
		{
			"path": "../durion-positivity-sdk-angular",
			"name": "SDK"
		}
	],
	"settings": {
		"terminal.integrated.scrollback": 2000,
		"typescript.tsserver.maxTsServerMemory": 2048,
		"files.exclude": {
			"**/.angular/**": true,
			"**/coverage/**": true,
			"**/dist/**": true,
			"**/build/**": true,
			"**/out/**": true,
			"**/target/**": true
		},
		"files.watcherExclude": {
			"**/.git/objects/**": true,
			"**/.git/subtree-cache/**": true,
			"**/.angular/**": true,
			"**/.gradle/**": true,
			"**/coverage/**": true,
			"**/dist/**": true,
			"**/build/**": true,
			"**/out/**": true,
			"**/target/**": true,
			"**/*.hprof": true,
			"**/*.log": true
		},
		"search.exclude": {
			"**/.angular/**": true,
			"**/.gradle/**": true,
			"**/coverage/**": true,
			"**/dist/**": true,
			"**/build/**": true,
			"**/out/**": true,
			"**/target/**": true,
			"**/*.hprof": true,
			"**/*.log": true
		},
		"angular.enable-strict-mode-prompt": false
	}
}
